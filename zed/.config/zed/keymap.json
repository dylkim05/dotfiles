[
  {
    "context": "Pane || Dock || Terminal || Editor && VimControl && vim_mode != insert",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-q": "pane::CloseActiveItem",
      "ctrl-o": "pane::ActivateNextItem",
      "ctrl-i": "pane::ActivatePreviousItem",
    },
  },
  {
    "context": "GitPanel || GitPanel > Editor && VimControl && !VimWaiting && vim_mode != insert",
    "bindings": {
      // focus
      "space f c": "git_panel::FocusChanges",
      "space f m": "git_panel::FocusEditor",
      "space q": "git_panel::Close",

      // git actions
      "space g p": "git::Push",
      "space g shift-p": "git::Pull",
      "space g shift-s": "git::Switch",
      "space g c": "git::Commit",
      "space g m": "git::GenerateCommitMessage",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      // file operations
      "n f": "project_panel::NewFile",
      "n d": "project_panel::NewDirectory",
      "d": "project_panel::Delete",
      "r": "project_panel::Rename",

      // close
      "space q": "project_panel::Toggle",
    },
  },
  {
    // empty pane
    "context": "EmptyPane",
    "bindings": {
      "space q w": "pane::CloseActiveItem",
      "space q z": "zed::Quit",
      "space n f": "workspace::NewFile",
      "space n p": "projects::OpenRecent",
      "space n t": "agent::NewThread",
      "space s p": "workspace::NewSearch",

      // open panels
      "space o l": "workspace::ToggleLeftDock",
      "space o r": "workspace::ToggleRightDock",
      "space o b": "workspace::ToggleBottomDock",
      "space o g": "git_panel::ToggleFocus",
      "space o p": "project_panel::ToggleFocus",
      "space o a": "agent::ToggleFocus",
      "space o t": "workspace::NewTerminal",

      // misc
      "space c p": "command_palette::Toggle",
      "space space": "file_finder::Toggle",

      // git actions
      "space g p": "git::Push",
      "space g shift-p": "git::Pull",
      "space g s": "git::Switch",
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu && vim_mode != insert",
    "bindings": {
      // close pane
      "space q w": "pane::CloseActiveItem",
      "space q a": "pane::CloseAllItems",

      // navigate
      "space n p": "projects::OpenRecent",
      "space n t": "agent::NewThread",

      // search
      "space s p": "workspace::NewSearch",
      "space s f": "buffer_search::DeployReplace",
      "space s s": "outline::Toggle",
      "space s S": "project_symbols::Toggle",

      // window/splits
      "space w v": "pane::SplitVertical",
      "space w h": "pane::SplitHorizontal",
      "space w w": "workspace::NewWindow",
      "space w z": "workspace::ToggleZoom",
      "g b": "pane::GoBack",

      // open panels
      "space o l": "workspace::ToggleLeftDock",
      "space o r": "workspace::ToggleRightDock",
      "space o b": "workspace::ToggleBottomDock",
      "space o g": "git_panel::ToggleFocus",
      "space o p": "project_panel::ToggleFocus",
      "space o a": "agent::ToggleFocus",
      "space o t": "workspace::NewTerminal",

      // misc
      "space c p": "command_palette::Toggle",
      "space space": "file_finder::Toggle",

      // git actions
      "space g p": "git::Push",
      "space g shift-p": "git::Pull",
      "space g s": "git::Switch",

      // tab navigation
      "g T": "pane::ActivatePreviousItem",
      "g t": "pane::ActivateNextItem",

      // diagnostics
      "]d": "editor::GoToDiagnostic",
      "[d": "editor::GoToPreviousDiagnostic",

      // git hunks
      "]h": "editor::GoToHunk",
      "[h": "editor::GoToPreviousHunk",

      // lsp
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c R": "editor::FindAllReferences",
      "space c f": "editor::Format",
      "space c d": "editor::GoToDefinition",
      "space c t": "editor::GoToTypeDefinition",
      "space c x": "diagnostics::Deploy",
      "K": "editor::Hover",
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu && vim_mode == visual",
    "bindings": {
      "space a a": "agent::AddSelectionToThread",
    },
  },
  {
    "context": "(AgentPanel > AcpThread > !MessageEditor) || (AgentPanel > Editor && VimControl && !VimWaiting && vim_mode != insert)",
    "bindings": {
      // close
      "space q": "workspace::ToggleRightDock",

      // open panels
      "space o l": "workspace::ToggleLeftDock",
      "space o r": "workspace::ToggleRightDock",
      "space o b": "workspace::ToggleBottomDock",

      // navigate
      "space n t": "agent::NewThread",
    },
  },
]
