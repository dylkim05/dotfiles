{
  "helix_mode": false,
  "semantic_tokens": "combined",
  "lsp": {
    "lean4-lsp": {
      "binary": {
        "path": "/Users/dylankim/.elan/bin/lake",
        "arguments": ["serve", "--"],
      },
      "settings": {
        "elan_auto_install": true,
        "elan_default_toolchain": "stable",
      },
    },
  },
  "languages": {
    "R": {
      "language_servers": ["air"],
    },
    "Python": {
      "language_servers": ["ty", "!basedpyright"],
    },
    "SQL": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "sql-formatter",
          "arguments": ["--language", "sqlite"],
        },
      },
    },
    "TypeScript": {
      "format_on_save": "on",
    },
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
      },
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "new_window",
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "format_on_save": "on",
  "show_edit_predictions": false,
  "agent": {
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "low",
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "icon_theme": "Catppuccin Macchiato",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Zedokai (Filter Spectrum)",
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 14,
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/bazel-*",
  ],
}
